import { readFile, writeFile } from "fs/promises";
import { Veterinarios } from "../models/veterinario";


export class VeterinarioRepository {


    private ruta = "./src/data/veterinarios.json";


    async obtenerVeterinarios(): Promise<Veterinarios[]> {

        try {

            const datos = await readFile(this.ruta, "utf-8");

            return JSON.parse(datos);

        } catch(error) {

            console.log("Error al leer veterinarios");

            return [];

        }

    }


    async guardarVeterinarios(veterinarios: Veterinarios[]): Promise<void> {

        try {

            await writeFile(
                this.ruta,
                JSON.stringify(veterinarios, null, 4)
            );

        } catch(error) {

            console.log("Error al guardar veterinarios");

        }

    }


}